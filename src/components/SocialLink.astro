---
// Satu link sosial: ikon SVG (aria-hidden) + label teks. Data dari socialLinks() di src/lib/socials.js.
const { s, cls = '' } = Astro.props;
---
<a href={s.url} class={`soc ${cls}`} data-soc={s.key} {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><svg class="soc-ic" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{s.paths.map((d) => <path d={d} />)}</svg><span>{s.label}</span></a>
